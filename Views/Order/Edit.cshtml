@model Ecommerce_Project.Models.Order

@{
  ViewData["Title"] = "Edit";
}

<div class="max-w-3xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="bg-white border border-gray-200 shadow-sm rounded-lg overflow-hidden">
    <div class="px-6 py-5">
      <h1 class="text-2xl font-semibold text-gray-900">Edit Order</h1>
      <p class="mt-1 text-sm text-gray-500">Update order details below.</p>
    </div>

    <div class="px-6 pb-6">
      <form asp-action="Edit" class="space-y-6">
        <div asp-validation-summary="ModelOnly" class="text-red-600 text-sm"></div>

        <input type="hidden" asp-for="OrderId" />

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label asp-for="OrderDate" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="OrderDate" type="date" class="mt-1 block w-full rounded-md border-gray-300 bg-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
            <span asp-validation-for="OrderDate" class="text-red-600 text-sm"></span>
          </div>

          <div>
            <label asp-for="TotalAmount" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="TotalAmount" type="number" step="0.01" class="mt-1 block w-full rounded-md border-gray-300 bg-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
            <span asp-validation-for="TotalAmount" class="text-red-600 text-sm"></span>
          </div>

          <div class="sm:col-span-2">
            <label asp-for="UserId" class="block text-sm font-medium text-gray-700"></label>
            <select asp-for="UserId" asp-items="ViewBag.UserId" class="mt-1 block w-full rounded-md border-gray-300 bg-white shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
              <option value="">Select user</option>
            </select>
            <span asp-validation-for="UserId" class="text-red-600 text-sm"></span>
          </div>
        </div>

        <div class="flex items-center justify-between pt-4">
          <div class="flex items-center gap-3">
            <button type="submit" class="inline-flex items-center px-4 py-2 bg-indigo-600 text-white text-sm font-medium rounded-md hover:bg-indigo-700 focus:outline-none focus:ring-2 focus:ring-indigo-500">
              Save
            </button>
            <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium rounded-md text-gray-700 hover:bg-gray-50">
              Cancel
            </a>
          </div>
        </div>
      </form>
    </div>
  </div>
</div>

@section Scripts {
  @{
    await Html.RenderPartialAsync("_ValidationScriptsPartial");
  }
}