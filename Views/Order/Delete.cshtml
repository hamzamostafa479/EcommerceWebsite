@model Ecommerce_Project.Models.Order

@{
  ViewData["Title"] = "Delete";
}

<div class="max-w-2xl mx-auto py-10 px-4 sm:px-6 lg:px-8">
  <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
    <div class="px-6 py-5">
      <h1 class="text-2xl font-semibold text-gray-900">Delete Order</h1>
      <p class="mt-1 text-sm text-gray-500">Are you sure you want to delete this order?</p>
    </div>

    <div class="px-6 pb-6">
      <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-4 text-sm">
        <div class="text-gray-600 font-medium">@Html.DisplayNameFor(model => model.OrderDate)</div>
        <div class="text-gray-800">@Html.DisplayFor(model => model.OrderDate)</div>

        <div class="text-gray-600 font-medium">@Html.DisplayNameFor(model => model.TotalAmount)</div>
        <div class="text-gray-800">@Html.DisplayFor(model => model.TotalAmount)</div>

        <div class="text-gray-600 font-medium">@Html.DisplayNameFor(model => model.User)</div>
        <div class="text-gray-800">@Html.DisplayFor(model => model.User.Id)</div>
      </div>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <form asp-action="Delete" class="inline">
          <input type="hidden" asp-for="OrderId" />
          <button type="submit" class="inline-flex items-center px-4 py-2 bg-red-600 text-white text-sm font-medium rounded-md hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
            Delete
          </button>
        </form>

        <a asp-action="Index" class="inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium rounded-md text-gray-700 hover:bg-gray-50">
          Cancel
        </a>
      </div>
    </div>
  </div>
</div>